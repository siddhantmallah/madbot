NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only — never prefix with NEXT_PUBLIC_, these must not reach the browser.
RESEND_API_KEY=

# Set this to switch on real article writing and AI visibility checks. Without
# it those screens stay in planning-only mode and say so.
ANTHROPIC_API_KEY=

# The service account, base64-encoded. Needed by the scheduler and by every
# licence check — without it, paid features refuse rather than assume.
FIREBASE_SERVICE_ACCOUNT_B64=

# Shared secret for /api/cron/tick. Unset means the endpoint refuses everyone
# rather than running for anyone.
CRON_SECRET=

# Comma-separated Firebase uids allowed to grant licences by hand via
# /api/billing/grant. Unset means nobody can, including you. Find a uid in
# Firebase console -> Authentication -> Users.
ADMIN_UIDS=

# Sender for welcome mail and digests. Must be an address on a domain verified
# in Resend, otherwise it falls back to Resend's sandbox sender, which only
# delivers to the Resend account's own address.
EMAIL_FROM=

# The address customers are told to write to, and the reply-to on outbound mail.
# Client-readable, so it must be NEXT_PUBLIC_. Needs a real inbox — verifying a
# domain for sending does not create one for receiving.
NEXT_PUBLIC_CONTACT_EMAIL=
