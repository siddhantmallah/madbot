NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only — never prefix with NEXT_PUBLIC_, these must not reach the browser.
RESEND_API_KEY=

# Set this to switch on real article writing and AI visibility checks. Without
# it those screens stay in planning-only mode and say so.
ANTHROPIC_API_KEY=

# The service account, base64-encoded. Needed by the scheduler and by every
# licence check — without it, paid features refuse rather than assume.
FIREBASE_SERVICE_ACCOUNT_B64=

# Shared secret for /api/cron/tick. Unset means the endpoint refuses everyone
# rather than running for anyone.
CRON_SECRET=

# Comma-separated Firebase uids allowed to grant licences by hand via
# /api/billing/grant. Unset means nobody can, including you. Find a uid in
# Firebase console -> Authentication -> Users.
ADMIN_UIDS=

# Signing secret for the Resend delivery webhook, from Resend -> Webhooks.
# Unset means the endpoint refuses every event rather than trusting unsigned
# bodies -- a forged event could suppress mail to a real customer.
RESEND_WEBHOOK_SECRET=

# Transactional sender — welcome mail, digests, receipts. Must always arrive,
# so it lives on the root domain where no campaign can damage its reputation.
# Unset falls back to Resend's sandbox sender, which only delivers to the Resend
# account's own address, so everything to a real customer silently vanishes.
EMAIL_FROM=MADBOT <notify@getmadbot.com>

# Promotional sender, on its own verified subdomain. If a campaign trips spam
# filters the damage is contained here and receipts keep landing. There is
# deliberately NO fallback to EMAIL_FROM — marketing refuses to send rather than
# borrow the transactional domain's reputation.
MARKETING_EMAIL_FROM=MADBOT <hello@mail.getmadbot.com>

# The one address a person actually reads. Shown in Billing as the way to buy,
# and set as reply-to on outbound mail so replies never land in a send-only
# inbox. Client-readable, so it must be NEXT_PUBLIC_. Needs a real mailbox —
# verifying a domain for sending does not create one for receiving. Left unset,
# the UI says so rather than printing an address that reaches nobody.
NEXT_PUBLIC_CONTACT_EMAIL=support@getmadbot.com

# Optional company-registry sources. Both are free to obtain and both degrade
# honestly when absent — the UI reports which sources are switched on. RDAP,
# Certificate Transparency and SEC EDGAR need no key at all.
COMPANIES_HOUSE_API_KEY=
OPENCORPORATES_API_KEY=
