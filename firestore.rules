rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // The client writes its own profile, never its own entitlements. Without
      // this split any signed-in user could grant themselves the top plan from
      // a browser console. The server writes subscriptions through the admin
      // SDK, which bypasses these rules.
      allow create: if isOwner(uid) && !request.resource.data.keys().hasAny(['subscription']);
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);
      allow delete: if false;

      // Billing history is readable by the customer and written only by the
      // server, so a receipt can't be forged or edited after the fact.
      match /billing/{entryId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // The internal event log behind those receipts. Server-only, both ways.
      match /billingEvents/{eventId} {
        allow read, write: if false;
      }

      match /sites/{siteId} {
        allow read, create, update, delete: if isOwner(uid);

        match /activity/{activityId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        match /approvals/{approvalId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        match /leads/{leadId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        match /content/{contentId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        match /competitors/{competitorId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        match /jobs/{jobId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        match /pages/{pageId} {
          allow read, create, update, delete: if isOwner(uid);
        }

        // Metered usage. The customer can see what they've spent; only the
        // server writes it. A client that could edit its own usage counters
        // could grant itself unlimited paid work, which is the entire point
        // of metering.
        match /usage/{period} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
